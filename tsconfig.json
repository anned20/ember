{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": [],
    "paths": {
      "@apps/*": ["./src/ts/apps/*"],
      "@background/*": ["./src/ts/background/*"],
      "@music/*": ["./src/ts/music/*"],
      "@voice/*": ["./src/ts/voice/*"],
      "@settings/*": ["./src/ts/settings/*"],
      "@focus/*": ["./src/ts/focus/*"],
      "@home/*": ["./src/ts/home/*"],
      "@config/*": ["./src/ts/config/*"],
      "@luna/*": ["./src/ts/luna/*"],
      "@lib/*": ["./src/ts/lib/*"]
    }
  },
  "include": ["./src/ts/**/*.ts", "test/**/*.ts"]
}
