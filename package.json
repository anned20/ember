{
  "name": "ember",
  "version": "0.9.1",
  "description": "Ember — a fullscreen home screen for rooted LG webOS TVs",
  "private": true,
  "scripts": {
    "brand": "node scripts/generate-brand.ts",
    "build": "node scripts/build.ts",
    "pack": "node scripts/build.ts --pack",
    "repo": "node scripts/build-repo.ts",
    "verify-ipk": "node scripts/verify-ipk.ts",
    "deploy": "bash scripts/deploy.sh",
    "sim": "npm run build && node scripts/simulator.ts",
    "sim:setup": "node scripts/simulator.ts setup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p scripts/tsconfig.json",
    "lint": "oxlint src/ts test scripts && knip",
    "precommit": "npm run typecheck && npm run lint && npm test",
    "prepare": "git config core.hooksPath .githooks",
    "clean": "rm -rf dist",
    "version:set": "node scripts/set-version.ts",
    "version": "node scripts/set-version.ts && git add version.md appinfo.json"
  },
  "devDependencies": {
    "@procot/webostv": "^1.2.6",
    "@types/node": "^26.6.5",
    "@webos-tools/cli": "^3.2.5",
    "esbuild": "^0.25.0",
    "jsdom": "^30.1.2",
    "knip": "^6.44.1",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "qrcode-generator": "^2.0.4"
  }
}
